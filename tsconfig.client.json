{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.client.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "lib/types/client",
    "outDir": "lib",
    "rootDir": "src/client",
    "sourceMap": true
  },
  "include": ["src/client/index.ts", "src/client/locales.ts"]
}
